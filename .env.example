# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# MemWal / Walrus
MEMWAL_PRIVATE_KEY=your_memwal_private_key_here
MEMWAL_ACCOUNT_ID=your_memwal_account_id_here
MEMWAL_SERVER_URL=https://walrus-testnet-rpc.walrus.space
MEMWAL_NAMESPACE=novera

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Website
PUBLIC_BOT_USERNAME=novera_bot
PUBLIC_DOMAIN=http://localhost:3000
