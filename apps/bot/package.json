{
  "name": "@novera/bot",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@novera/ai": "workspace:*",
    "@novera/core": "workspace:*",
    "@novera/memory": "workspace:*",
    "@novera/shared": "workspace:*",
    "dotenv": "^16.3.1",
    "grammy": "^1.21.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
